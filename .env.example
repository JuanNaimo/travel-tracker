# Este archivo se usa para desarrollo local Y Docker Compose

# ============================================
# POSTGRESQL DATABASE
# ============================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=travel_user
DB_PASSWORD=travel_password_2024
DB_NAME=travel_tracker
