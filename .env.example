# ============================================
# CONFIGURACIÓN GLOBAL - Travel Tracker App
# ============================================
# Copia este archivo como .env (o ejecuta ./scripts/setup-env.sh, que además
# genera las contraseñas y el JWT_SECRET). Se usa para Docker Compose y para
# desarrollo local.

# ============================================
# POSTGRESQL DATABASE
# ============================================
DB_HOST=localhost
# Puerto de PostgreSQL en tu máquina
DB_PORT=5432
DB_NAME=travel_tracker
DB_SSLMODE=disable
# Superusuario: crea el esquema al iniciar el contenedor
DB_USER=travel_user
DB_PASSWORD=
# Rol sin privilegios que usa la API en Docker (las políticas RLS aplican)
DB_APP_USER=travel_app
DB_APP_PASSWORD=

# ============================================
# BACKEND API (Go)
# ============================================
# Puerto del API en tu máquina
PORT=3001
# Obligatorio, mínimo 32 caracteres. Generalo con: openssl rand -hex 32
JWT_SECRET=
# Duración del access token (JWT) y del refresh token
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
# Orígenes permitidos por CORS (separados por coma)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ============================================
# FRONTEND (Next.js)
# ============================================
# Puerto del frontend en tu máquina
FRONT_PORT=3000
# URL con la que el navegador llega al API (se incrusta al construir la imagen)
NEXT_PUBLIC_API_URL=http://localhost:3001/api
