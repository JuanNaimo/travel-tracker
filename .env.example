# ============================================
# CONFIGURACIÓN GLOBAL - Travel Tracker App
# ============================================
# Copia este archivo como .env y configura tus valores
# Este archivo se usa para desarrollo local Y Docker Compose

# ============================================
# POSTGRESQL DATABASE
# ============================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=travel_user
DB_PASSWORD=travel_password_2024
DB_NAME=travel_tracker
DB_SSLMODE=disable

# ============================================
# BACKEND API (Go)
# ============================================
PORT=3001
# Obligatorio, mínimo 32 caracteres. Generalo con: openssl rand -hex 32
JWT_SECRET=
# Duración del access token (JWT) y del refresh token
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
# Orígenes permitidos por CORS (separados por coma)
CORS_ALLOWED_ORIGINS=http://localhost:3000
ENV=development

# ============================================
# FRONTEND (Next.js)
# ============================================
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NODE_ENV=development
