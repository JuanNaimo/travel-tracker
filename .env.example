# Valores de ejemplo SOLO para desarrollo (son públicos).
# `make up` / ./scripts/setup-env.sh genera el .env con secretos aleatorios.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=travel_tracker
DB_SSLMODE=disable
DB_USER=travel_user
DB_PASSWORD=travel_password_dev
DB_APP_USER=travel_app
DB_APP_PASSWORD=travel_app_password_dev

PORT=3001
# Mínimo 32 caracteres: openssl rand -hex 32
JWT_SECRET=dev_only_jwt_secret_change_me_0123456789abcdef
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
CORS_ALLOWED_ORIGINS=http://localhost:3000

FRONT_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api
